# Supabase (a URL e a chave pública também são usadas para gerar public/config.js)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_OU_ANON
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE_NUNCA_EXPOSTA_NO_NAVEGADOR

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-OU-TEST-SEU-ACCESS-TOKEN
MP_WEBHOOK_SECRET=SUA_CHAVE_SECRETA_DE_WEBHOOK
MP_USE_SANDBOX=true

# URL pública do site. Em produção pode ser o domínio do Netlify.
SITE_URL=https://seu-site.netlify.app
